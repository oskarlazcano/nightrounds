---
import { faqs } from '../data/site';

interface Props {
  items?: { q: string; a: string }[];
}
const { items = faqs } = Astro.props;
---

<div class="faq">
  {
    items.map((item) => (
      <details>
        <summary>{item.q}</summary>
        <p>{item.a}</p>
      </details>
    ))
  }
</div>

<style>
  .faq {
    border-top: 1px solid var(--line);
  }
  details {
    border-bottom: 1px solid var(--line);
  }
  summary {
    list-style: none;
    cursor: pointer;
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 16px;
    padding: 22px 0;
    font-family: var(--font-display);
    font-size: 1.25rem;
    font-weight: 560;
    font-variation-settings: 'opsz' 36;
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary::after {
    content: '+';
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    border-radius: 50%;
    border: 1px solid var(--line);
    font-family: var(--font-body);
    font-size: 1.25rem;
    color: var(--anchor);
  }
  details[open] summary::after {
    content: '\2212';
    background: var(--anchor-soft);
  }
  p {
    margin: -6px 0 24px;
    max-width: 64ch;
    color: var(--muted);
  }
</style>
