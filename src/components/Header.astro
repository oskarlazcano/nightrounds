---
import { nav, site } from '../data/site';
import Icon from './Icon.astro';
import Wordmark from './Wordmark.astro';

const path = Astro.url.pathname.replace(/\/$/, '') || '/';
const isCurrent = (href: string) => path === href || path.startsWith(`${href}/`);
---

<header class="site-header">
  <div class="wrap bar">
    <a href="/" class="brand" aria-label={`${site.name} home`}><Wordmark /></a>

    <nav class="nav" id="site-nav" aria-label="Main">
      <ul>
        {
          nav.map((item) => (
            <li>
              <a href={item.href} aria-current={isCurrent(item.href) ? 'page' : undefined}>
                {item.label}
              </a>
            </li>
          ))
        }
        {
          site.links.supportPortal && (
            <li class="support">
              <a href={site.links.supportPortal}>Client support</a>
            </li>
          )
        }
        <li class="nav-cta">
          <a class="btn btn-primary" href="/book-a-call">Book a Free 20-Minute Call</a>
        </li>
      </ul>
    </nav>

    <a class="btn btn-primary header-cta" href="/book-a-call">Book a call</a>

    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">
      <span class="sr-only">Menu</span>
      <Icon name="menu" class="i-open" />
      <Icon name="close" class="i-close" />
    </button>
  </div>
</header>

<script>
  const header = document.querySelector('.site-header');
  const toggle = header?.querySelector<HTMLButtonElement>('.menu-toggle');
  toggle?.addEventListener('click', () => {
    const open = toggle.getAttribute('aria-expanded') !== 'true';
    toggle.setAttribute('aria-expanded', String(open));
    header?.classList.toggle('open', open);
  });
  document.addEventListener('keydown', (e) => {
    if (e.key === 'Escape' && header?.classList.contains('open')) {
      header.classList.remove('open');
      toggle?.setAttribute('aria-expanded', 'false');
      toggle?.focus();
    }
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in srgb, var(--bg) 92%, transparent);
    backdrop-filter: saturate(1.4) blur(10px);
    border-bottom: 1px solid var(--line);
  }
  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 76px;
  }
  .brand {
    text-decoration: none;
    margin-right: auto;
  }
  .nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .nav a:not(.btn) {
    color: var(--text);
    text-decoration: none;
    font-weight: 600;
  }
  .nav a[aria-current='page'] {
    color: var(--anchor);
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 8px;
  }
  .header-cta {
    min-height: 44px;
    padding: 10px 18px;
    font-size: 0.9375rem;
  }
  .menu-toggle {
    display: inline-grid;
    place-items: center;
    width: 48px;
    height: 48px;
    border-radius: 12px;
    border: 1px solid var(--line);
    background: var(--surface);
    color: var(--text);
    cursor: pointer;
  }
  .menu-toggle :global(.i-close),
  .open .menu-toggle :global(.i-open) {
    display: none;
  }
  .open .menu-toggle :global(.i-close) {
    display: block;
  }

  /* Mobile: slide-down panel, thumb-friendly targets */
  @media (max-width: 1079px) {
    .nav {
      display: none;
      position: absolute;
      inset: 100% 0 auto;
      background: var(--bg);
      border-bottom: 1px solid var(--line);
      box-shadow: var(--shadow);
    }
    .open .nav {
      display: block;
    }
    .nav ul {
      width: 100%;
      max-width: var(--wrap);
      margin-inline: auto;
      padding: 8px var(--gutter) 24px;
      display: grid;
    }
    .nav li:not(.nav-cta) a {
      display: block;
      padding: 14px 0;
      border-bottom: 1px solid var(--line);
      font-size: 1.125rem;
    }
    .nav-cta {
      margin-top: 20px;
    }
    .nav-cta .btn {
      width: 100%;
    }
  }
  @media (max-width: 479px) {
    .header-cta {
      display: none;
    }
  }

  @media (min-width: 1080px) {
    .menu-toggle,
    .header-cta {
      display: none;
    }
    .nav ul {
      display: flex;
      align-items: center;
      gap: 30px;
    }
    .nav-cta .btn {
      min-height: 46px;
      padding: 10px 20px;
      font-size: 0.9375rem;
    }
  }
</style>
