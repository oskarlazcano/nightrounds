---
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import LeadForm from '../components/LeadForm.astro';
import PageHero from '../components/PageHero.astro';
import Base from '../layouts/Base.astro';
import { checklist, services, segments } from '../data/site';

const pains = [
  {
    title: 'Shared nursing stations',
    body: 'One workstation, many staff, every shift. Sign-in has to be fast and still tied to the right person.',
    fit: 'managed-it-security',
  },
  {
    title: 'High staff turnover',
    body: 'New hires need access on day one; departures need it removed the same day. Agency staff complicate both.',
    fit: 'managed-it-security',
  },
  {
    title: 'EHR-dependent workflows',
    body: 'When charting or the eMAR can’t load, care slows down. Someone needs to sort out access fast and tell the vendor what’s wrong.',
    fit: 'after-hours-help-desk',
  },
  {
    title: 'Nights and weekends',
    body: 'Most of the hours your building is open, a typical IT provider is closed.',
    fit: 'after-hours-help-desk',
  },
  {
    title: 'Surveys, insurers, and audits',
    body: 'Questions about security risk analysis, MFA, and backups keep getting harder to answer from memory.',
    fit: 'hipaa-security-program',
  },
  {
    title: 'Multiple sites, thin admin teams',
    body: 'Regional operators need the same answers from every building, written down the same way.',
    fit: 'hipaa-security-program',
  },
];

const byslug = Object.fromEntries(services.map((s) => [s.slug, s]));
---

<Base
  title="IT for Long-Term Care"
  description="IT support, overnight help, and HIPAA security help for skilled nursing, assisted living, memory care, home health, and hospice."
>
  <PageHero
    eyebrow="Long-term care"
    title="IT that keeps up with a 24-hour building."
    lede="Built for skilled nursing, assisted living, memory care, home health, and hospice: shared stations, constant shift changes, and care that depends on the EHR."
  >
    <a class="btn btn-primary" href="/book-a-call">Book a Free 20-Minute Call</a>
    <a class="text-link" href="#checklist">Get the checklist <Icon name="arrow" size={18} /></a>
  </PageHero>

  <section class="section">
    <div class="wrap">
      <ul class="segs" aria-label="Care settings we support">{segments.map((s) => <li class="pill">{s}</li>)}</ul>
      <h2>What we hear from facilities</h2>
      <p class="lede">And which part of NightRounds handles it.</p>
      <div class="grid grid-3 pains">
        {
          pains.map((p) => (
            <div class="card pain">
              <h3>{p.title}</h3>
              <p class="muted">{p.body}</p>
              <a class="fit" href={byslug[p.fit].href}>
                <Icon name={byslug[p.fit].icon} size={20} /> {byslug[p.fit].name}
              </a>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section deep" id="checklist">
    <div class="wrap split">
      <div>
        <span class="eyebrow">Free download</span>
        <h2>{checklist.title}</h2>
        <p class="lede">A practical walk-through for administrators and directors of nursing. It covers:</p>
        <ul class="covers">{checklist.covers.map((c) => <li>{c}</li>)}</ul>
        <p class="muted small">{checklist.label}</p>
      </div>
      <div class="form-card">
        <LeadForm kind="checklist" />
      </div>
    </div>
  </section>

  <CtaBand secondary={{ label: 'Request an assessment', href: '/contact?type=assessment' }} />
</Base>

<style>
  .segs {
    list-style: none;
    padding: 0;
    margin: 0 0 40px;
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }
  .pains {
    margin-top: 32px;
  }
  .pain {
    display: flex;
    flex-direction: column;
  }
  .fit {
    margin-top: auto;
    display: inline-flex;
    align-items: center;
    gap: 8px;
    padding-top: 16px;
    border-top: 1px solid var(--line);
    font-weight: 700;
    text-decoration: none;
  }
  .fit:hover {
    text-decoration: underline;
  }
  .covers {
    margin: 0 0 20px;
    padding-left: 1.2em;
    display: grid;
    gap: 6px;
  }
  .covers li::marker {
    color: var(--accent);
  }
  .small {
    font-size: 0.9375rem;
  }
  .form-card {
    background: var(--surface);
    color: var(--text);
    border-radius: var(--radius-lg);
    padding: clamp(22px, 3vw, 36px);
  }
  .form-card :global(a:not(.btn)) {
    color: var(--anchor);
  }
</style>
